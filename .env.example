# Diet Recommendation System Environment Configuration

# Application Settings
APP_NAME=Diet Recommendation System API
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=false

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.com

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/recommendation_system.log
LOG_FORMAT=json

# Model Configuration
MODEL_CONFIG=production
K_CANDIDATES=50
N_CLUSTERS=20
N_SVD_COMPONENTS=5
RANDOM_SEED=42

# Data Configuration
DATA_PATH=Data/dataset.csv
CACHE_ENABLED=true
CACHE_TTL=3600
MAX_RECOMMENDATIONS=20

# API Configuration
API_TITLE=Diet Recommendation System API
API_DESCRIPTION=AI-powered nutrition-based recipe recommendations using hybrid filtering
API_VERSION=1.0.0

# Validation Settings
MIN_CALORIES=0.0
MAX_CALORIES=5000.0
MIN_MACRO_VALUE=0.0
MAX_FAT=200.0
MAX_SODIUM=10000.0

# Performance Settings
ENABLE_BENCHMARKING=true
ENABLE_MODEL_EXPLAINABILITY=true
DEFAULT_N_NEIGHBORS=5
MAX_N_NEIGHBORS=100

# Security Settings (for future use)
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Database Settings (for future use)
DATABASE_URL=postgresql://user:password@localhost:5432/diet_recommendation
REDIS_URL=redis://localhost:6379

# External API Keys (for future integrations)
NUTRITION_API_KEY=your-nutrition-api-key
WEATHER_API_KEY=your-weather-api-key

# Monitoring & Analytics
ENABLE_PROMETHEUS_METRICS=false
PROMETHEUS_PORT=9090
SENTRY_DSN=your-sentry-dsn-here

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# Feature Flags
ENABLE_FEEDBACK_COLLECTION=true
ENABLE_USER_PROFILING=false
ENABLE_EXPERIMENTAL_MODELS=false

# Email Configuration (for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Development Settings
DEV_DATABASE_URL=sqlite:///./dev.db
TEST_DATABASE_URL=sqlite:///./test.db